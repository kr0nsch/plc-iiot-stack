    {
      "type": "barchart",
      "title": "Наработка по суткам, ч",
      "description": "Сутки — по часовому поясу станции (Europe/Moscow)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-kns"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-kns"
          },
          "query": "import \"timezone\"\nimport \"date\"\n\noption location = timezone.location(name: \"${tz}\")\n\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"value\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.metric == \"run_hours\" and (r.device == \"P101\" or r.device == \"P102\" or r.device == \"P103\"))\n  |> difference(nonNegative: true)\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true, timeSrc: \"_start\")\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> group()\n  |> map(fn: (r) => {\n        months = [\"янв\", \"фев\", \"мар\", \"апр\", \"мая\", \"июн\", \"июл\", \"авг\", \"сен\", \"окт\", \"ноя\", \"дек\"]\n        return {r with day: string(v: date.monthDay(t: r._time)) + \" \" + months[date.month(t: r._time) - 1]}\n    })\n  |> pivot(rowKey: [\"_time\", \"day\"], columnKey: [\"device\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])\n  |> drop(columns: [\"_time\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ч",
          "decimals": 1,
