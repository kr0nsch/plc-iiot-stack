// Назначение: значение ушло от последнего опубликованного больше зоны нечувствительности:
//             |новое - последнее| > зона (строго больше; зона <= 0 или не число — любое изменение).
//             Переход между конечным и неконечным значением — изменение, два неконечных — нет.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/plc_mqtt.md, раздел «Телеметрия»
FUNCTION F_IiotDeadbandExceeded : BOOL
VAR_INPUT
    lrNew : LREAL;      // текущее значение
    lrLast : LREAL;     // последнее опубликованное
    rDeadband : REAL;   // зона нечувствительности, в единицах значения
END_VAR
VAR
    xNewFinite : BOOL;
    xLastFinite : BOOL;
    lrDiff : LREAL;
END_VAR
