# Переводы строк нормализуются в LF (CONTRIBUTING.md); исключение — пакетные файлы Windows
* text=auto eol=lf

*.st    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
# Скрипты PowerShell — CRLF и UTF-8 с BOM (для Windows PowerShell 5.1)
*.ps1   text eol=crlf

# GitHub Linguist не знает IEC 61131-3 Structured Text и относит .st к Smalltalk; в языковой
# панели репозитория ST показывается как ближайший по синтаксису Pascal.
*.st    linguist-language=Pascal

# Двоичные файлы: без нормализации и текстового диффа.
# Проекты и библиотеки CODESYS в git не хранятся (.gitignore), правила — на случай вложений к релизам.
*.project         binary
*.projectarchive  binary
*.library         binary
*.compiled-library binary
*.package         binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
