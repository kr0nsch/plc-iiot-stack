# Настройки и секреты стенда (docker compose, эмулятор, отчёт). В git — только этот файл.
# Рабочий .env создаёт make env (или tools_project/make.ps1 env): копирует этот файл и заменяет
# каждое значение change-me случайным паролем. Строки без change-me можно менять вручную.
# Описание — docs/ARCHITECTURE.md, раздел «Секреты и настройки».

# --- MQTT (Mosquitto) ------------------------------------------------------------------------
# Корень топиков: {site}/{area}/{unit}/{device}/{metric} (docs/data_schema.md)
MQTT_TOPIC_ROOT=vodokanal
# ПЛК или эмулятор: публикует телеметрию, тревоги, ответы; читает команды
MQTT_PLC_USER=plc
MQTT_PLC_PASSWORD=change-me
# Telegraf: только чтение
MQTT_TELEGRAF_USER=telegraf
MQTT_TELEGRAF_PASSWORD=change-me
# Оператор (HMI, Node-RED, тесты): чтение и команды
MQTT_OPERATOR_USER=operator
MQTT_OPERATOR_PASSWORD=change-me
# Проверка здоровья брокера: только $SYS
MQTT_MONITOR_USER=monitor
MQTT_MONITOR_PASSWORD=change-me
# Порт 1883 на хосте: 127.0.0.1 — только этот компьютер (CODESYS Control Win, тесты)
MQTT_BIND=127.0.0.1
MQTT_PORT=1883
# Слушатель TLS (make up TLS=1, сертификаты — make certs): к нему подключается ПЛК из сети
MQTT_TLS_BIND=0.0.0.0
MQTT_TLS_PORT=8883

# --- InfluxDB 2 ------------------------------------------------------------------------------
# Администратор и его токен нужны только для первичной установки и сервиса influxdb-init;
# Telegraf и Grafana получают свои токены с минимальными правами
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_ADMIN_TOKEN=change-me
INFLUX_ORG=vodokanal
# Сырые данные (Telegraf) и часовые агрегаты (задача kns_downsample_1h)
INFLUX_BUCKET=kns_raw
INFLUX_RETENTION=30d
INFLUX_BUCKET_AGG=kns_agg
INFLUX_RETENTION_AGG=730d
# Порт InfluxDB на 127.0.0.1 — только с docker-compose.dev.yml (make up DEV=1): отчёт, тесты
INFLUX_PORT=8086

# --- OPC UA (вход Telegraf) ------------------------------------------------------------------
# true — Telegraf дополнительно опрашивает OPC UA-сервер и пишет те же метрики с source=opcua
OPCUA_ENABLED=true
# Эмулятор (make demo): opc.tcp://emulator:4840
# CODESYS Control Win на этом компьютере: opc.tcp://host.docker.internal:4840
OPCUA_ENDPOINT=opc.tcp://emulator:4840
# Номер пространства имён и префикс узлов символьной конфигурации (сверить по обзору сервера;
# у ПЛК210 имя устройства в префиксе другое)
OPCUA_NAMESPACE=4
OPCUA_ID_PREFIX="|var|CODESYS Control Win V3."
# Эмулятор: None / None / Anonymous (анонимно — только чтение).
# Рантайм CODESYS: Basic256Sha256 / SignAndEncrypt / UserName (пользователь рантайма с правом чтения)
OPCUA_SECURITY_POLICY=None
OPCUA_SECURITY_MODE=None
# Сертификат и ключ клиента Telegraf (политика не None). Пусто — том telegraf-pki: Telegraf один раз
# создаёт самоподписанный сертификат, его кладут в доверенные сервера (docs/security.md, 4.2)
OPCUA_CERTIFICATE=
OPCUA_PRIVATE_KEY=
OPCUA_AUTH_METHOD=Anonymous
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_INTERVAL=10s

# --- Grafana ---------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Ключ шифрования секретов в базе Grafana (вместо общего ключа по умолчанию)
GRAFANA_SECRET_KEY=change-me
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000

# --- Эмулятор ПЛК (make demo) ----------------------------------------------------------------
# Ускорение модельного времени: 60 — минута модели за секунду (сутки за 24 минуты)
EMU_TIME_FACTOR=60
# Анонимное чтение OPC UA эмулятора (для Telegraf в демо)
EMU_OPCUA_ALLOW_ANONYMOUS=true
EMU_LOG_LEVEL=INFO

# --- Node-RED (профиль nodered, по желанию) --------------------------------------------------
NODERED_CREDENTIAL_SECRET=change-me
NODERED_PORT=1880
TZ=Europe/Moscow
