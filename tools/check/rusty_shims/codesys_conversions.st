(*
    Прокладки преобразований TIME и LTIME для проверки RuSTy (только объявления, не для CODESYS).

    В CODESYS есть преобразования TIME_TO_DINT, UDINT_TO_TIME, LTIME_TO_UDINT и т. п. для всех
    целых, битовых и REAL; в стандартной библиотеке RuSTy 1.0.6 — только для LINT, ULINT, LWORD,
    LREAL и строк (без прокладки — ошибка E048). Здесь объявлены недостающие: типы аргумента и
    результата как в CODESYS, тела нет. Проверяются только типы: в RuSTy TIME 64-битный (нс),
    в CODESYS — 32-битный (мс), LTIME — 64-битный (нс).
*)

FUNCTION TIME_TO_BYTE : BYTE
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION BYTE_TO_TIME : TIME
VAR_INPUT
    in : BYTE;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_WORD : WORD
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION WORD_TO_TIME : TIME
VAR_INPUT
    in : WORD;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_DWORD : DWORD
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION DWORD_TO_TIME : TIME
VAR_INPUT
    in : DWORD;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_SINT : SINT
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION SINT_TO_TIME : TIME
VAR_INPUT
    in : SINT;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_USINT : USINT
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION USINT_TO_TIME : TIME
VAR_INPUT
    in : USINT;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_INT : INT
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

FUNCTION INT_TO_TIME : TIME
VAR_INPUT
    in : INT;
END_VAR
END_FUNCTION

FUNCTION TIME_TO_UINT : UINT
VAR_INPUT
    in : TIME;
END_VAR
END_FUNCTION

