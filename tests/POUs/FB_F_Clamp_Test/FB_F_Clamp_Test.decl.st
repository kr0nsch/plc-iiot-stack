// Назначение: набор тестов CfUnit (coUnit 1.2.0.0) для F_Clamp — значение внутри
//             диапазона, ниже, выше, на границах, вырожденный диапазон и границы
//             в обратном порядке. Экземпляр объявлен в PRG_Tests: объявление
//             регистрирует набор в coUnit, вызывать его вручную не нужно.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/TEST_REPORT.md
FUNCTION_BLOCK FB_F_Clamp_Test EXTENDS coUnit.FB_TestSuite
VAR CONSTANT
    // Ожидаемые значения не равны нулю: функция без реализации вернула бы 0,
    // и тест с ожиданием 0 прошёл бы ложно.
    R_LOW : REAL := 2.0;        // нижняя граница тестового диапазона
    R_HIGH : REAL := 10.0;      // верхняя граница тестового диапазона
    R_INSIDE : REAL := 5.0;     // значение внутри диапазона
    R_BELOW : REAL := -3.0;     // значение ниже диапазона
    R_ABOVE : REAL := 12.5;     // значение выше диапазона
    // F_Clamp возвращает один из своих аргументов без арифметики — сравнение точное
    R_DELTA : REAL := 0.0;
END_VAR
