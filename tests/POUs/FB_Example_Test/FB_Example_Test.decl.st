// Назначение: набор тестов CfUnit (coUnit 1.2.0.0) для FB_Example — включение и отключение
//             по порогам гистерезиса и на самих порогах, удержание состояния в зоне
//             гистерезиса, защёлка отказа измерения и квитирование, режимы Manual, Local,
//             OutOfService, режим по умолчанию, ограничение параметров, счётчик включений
//             и сброс через I_Resettable. Каждый тест работает со своим экземпляром FB_Example
//             (локальная переменная метода) и укладывается в один цикл.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/TEST_REPORT.md
FUNCTION_BLOCK FB_Example_Test EXTENDS coUnit.FB_TestSuite
VAR CONSTANT
    // Уставка отключения и гистерезис: включение при значении <= 50 %, отключение при >= 60 %
    R_SP_PCT : REAL := 60.0;
    R_HYST_PCT : REAL := 10.0;
    R_ON_THRESHOLD_PCT : REAL := 50.0;  // порог включения: R_SP_PCT - R_HYST_PCT
    R_LOW_PCT : REAL := 40.0;           // ниже порога включения
    R_BAND_PCT : REAL := 55.0;          // внутри зоны гистерезиса
    R_HIGH_PCT : REAL := 70.0;          // выше уставки отключения
    // Параметры вне допустимых диапазонов GVL_Const
    R_SP_TOO_HIGH_PCT : REAL := 150.0;
    R_HYST_TOO_LOW_PCT : REAL := 0.1;
    // F_Clamp возвращает одну из своих границ без арифметики — сравнение точное
    R_DELTA : REAL := 0.0;
    UDI_TWO_SWITCH_ONS : UDINT := 2;    // ожидаемое число включений в тесте счётчика
END_VAR
